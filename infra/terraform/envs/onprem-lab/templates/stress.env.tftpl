# 由 Terraform（infra/terraform/envs/onprem-lab）產生，control 第一次開機時放置；之後在 VM 上的修改不會被覆蓋。
# 未列出的參數沿用 /opt/k6-stress/onprem/config/defaults.env（地端規劃的正式值）。

BASE_URL=${base_url}
FRONTEND_URL=${frontend_url}
ALLOW_REMOTE_TARGET=true
RUNNERS='${runners}'
%{ if stage_plan != "" ~}

# lab 縮小版階段（正式值見 defaults.env）
STAGE_PLAN='${stage_plan}'
%{ endif ~}
%{ if max_vus > 0 ~}
MAX_VUS=${max_vus}
%{ endif ~}

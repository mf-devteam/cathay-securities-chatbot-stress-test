#!/usr/bin/env bash
# 壓測操作選單（control）：給證券方執行人員用，輸入數字即可操作，不需要記 k6ctl 指令。
# 主選單是 v3 分開測試（腳本甲 業務查詢 → 腳本乙 FAQ 問答 → 合併報表，底層為 k6suite）；
# 對客戶一律稱「腳本甲／乙」（客戶 2026-11-16 要求）；程式內部代號仍為 A／B（RUN_A、-A、v3a）
# 舊版測試（逐階加壓正式壓測、對話回應時間測試）收在「9) 其他測試」。
# 底層呼叫 k6suite／k6ctl；進階操作仍可直接用指令（k6suite help、k6ctl help）。
# 以 k6 帳號執行；其他帳號執行時會自動 sudo -u k6。
set -uo pipefail

APP_DIR="${APP_DIR:-/opt/k6-stress}"
DATA_DIR="${DATA_DIR:-/var/lib/k6-stress}"
CONF_FILE="${CONF_FILE:-/etc/k6-stress/stress.env}"
K6_USER="${K6_USER:-k6}"
K6CTL="${APP_DIR}/onprem/bin/k6ctl"
K6SUITE="${APP_DIR}/onprem/bin/k6suite"

if [ "$(id -un)" != "$K6_USER" ]; then
    exec sudo -u "$K6_USER" -H "$0" "$@"
fi
[ -t 0 ] || { echo "k6menu 需要在終端機中執行" >&2; exit 1; }

if [ -t 1 ] && [ "$(tput colors 2>/dev/null || echo 0)" -ge 8 ]; then
    G=$'\e[32m'; R=$'\e[31m'; Y=$'\e[33m'; B=$'\e[1m'; N=$'\e[0m'
else
    G=''; R=''; Y=''; B=''; N=''
fi
ok()   { echo "  ${G}✓ $*${N}"; }
bad()  { echo "  ${R}✗ $*${N}"; }
warn() { echo "  ${Y}! $*${N}"; }
line() { echo "================================================"; }

load_config() {
    set -a
    # shellcheck disable=SC1091
    . "${APP_DIR}/onprem/config/defaults.env"
    # shellcheck disable=SC1090
    [ -f "$CONF_FILE" ] && . "$CONF_FILE"
    set +a
    CONTACT="${SUPPORT_CONTACT:-MF 壓測支援}"
}

pause() { echo; read -r -p "  按 Enter 回到選單…" _; }

confirm() { # confirm <提示>：輸入 yes 才回傳 0
    local ans
    echo
    read -r -p "  $1 確定請輸入 yes（其他任何輸入＝取消）：" ans
    [ "$ans" = yes ] && return 0
    echo "  已取消。"
    return 1
}

# 舊版測試的最近一輪（不含 v3 測試的腳本甲／乙＝-A／-B，那些由 k6suite 管理）
latest_run() { ls -1t "${DATA_DIR}/runs" 2>/dev/null | grep -Ev -- '-v3.*-[AB]$' | head -1; }

# 0 全部結束、1 執行中、2 有 runner 異常、3 沒有紀錄
run_state() {
    local run="$1"
    [ -n "$run" ] && [ -f "${DATA_DIR}/runs/${run}/runners.txt" ] || return 3
    "$K6CTL" status "$run" >/dev/null 2>&1
}

# 讀取某一輪實際使用的參數（run.env），算出各階段的起訖分鐘
load_plan() { # load_plan <RUN_ID>：設定 PLAN_IDS、PLAN_TPS、PLAN_END（累計分鐘）、PLAN_TOTAL
    local run="$1" plan scope entry id load hold ramp t=0
    plan="$(set -a; . "${DATA_DIR}/runs/${run}/run.env" 2>/dev/null; echo "${STAGE_SCOPE:-full}|${STAGE_PLAN}")"
    scope="${plan%%|*}"; plan="${plan#*|}"
    PLAN_IDS=(); PLAN_TPS=(); PLAN_END=()
    IFS=';' read -r -a entries <<< "$plan"
    for entry in "${entries[@]}"; do
        IFS=':' read -r id load hold ramp <<< "$entry"
        t=$((t + ${ramp:-0} + ${hold:-0}))
        PLAN_IDS+=("$id"); PLAN_TPS+=("${load%tps}"); PLAN_END+=("$t")
        [ "$scope" = smoke ] && break
    done
    PLAN_TOTAL="$t"
}

started_epoch() { # run.env 第一行：# k6ctl start <ISO 時間> by <帳號>
    date -d "$(head -1 "${DATA_DIR}/runs/$1/run.env" | awk '{ print $4 }')" +%s 2>/dev/null || echo 0
}

# 壓測中：已經過幾分鐘、目前在哪個階段
progress_text() {
    local run="$1" start elapsed i
    load_plan "$run"
    start="$(started_epoch "$run")"
    elapsed=$(( ($(date +%s) - start) / 60 ))
    for i in "${!PLAN_IDS[@]}"; do
        if [ "$elapsed" -lt "${PLAN_END[$i]}" ]; then
            echo "已執行 ${elapsed} 分鐘／約 ${PLAN_TOTAL} 分鐘，目前階段 ${PLAN_IDS[$i]}（${PLAN_TPS[$i]} TPS）"
            return
        fi
    done
    echo "已執行 ${elapsed} 分鐘，階段已跑完，收尾中（約 1～2 分鐘）"
}

header() {
    local run rc=0 suite
    clear 2>/dev/null || true
    line
    echo "  ${B}新阿發 壓力測試${N}　　$(date '+%Y-%m-%d %H:%M')"
    echo "  受測端：${BASE_URL}"
    echo "  runner：$(tr ';' ' ' <<< "${RUNNERS}")"
    if suite="$(suite_running)"; then
        echo "  狀態：${Y}${B}測試執行中${N}（${suite}）"
        echo "        $("$K6SUITE" brief "$suite" 2>/dev/null)，選 5 查看進度"
        line
        return
    fi
    if [ "$(latest_kind)" = suite ]; then
        echo "  狀態：沒有執行中的測試（上一組 $(latest_suite) 已結束，選 7 取得報表）"
        line
        return
    fi
    run="$(latest_run)"
    run_state "$run" || rc=$?
    case "$rc" in
        3) echo "  狀態：尚未執行過壓測" ;;
        1) echo "  狀態：${Y}${B}壓測執行中${N}（${run}）"; echo "        $(progress_text "$run")" ;;
        0) echo "  狀態：沒有執行中的壓測（上一輪 ${run} 已結束）" ;;
        *) echo "  狀態：${R}上一輪 ${run} 有 runner 異常，請選 5 查看${N}" ;;
    esac
    line
}

menu() {
    echo "   1) 壓測前檢查        （每次測試前先做，約 1 分鐘）"
    echo "   2) 試跑 甲→乙        （低流量，確認流程與報表正常，約 $(suite_minutes smoke) 分鐘）"
    echo "   3) 正式測試 1 倍     （甲 業務查詢 → 乙 FAQ 問答 → 報表，約 $(suite_minutes x1) 分鐘）"
    echo "   4) 正式測試 3 倍     （甲 業務查詢 → 乙 FAQ 問答 → 報表，約 $(suite_minutes x3) 分鐘）"
    echo "   5) 查看進度"
    echo "   6) 停止測試"
    echo "   7) 取得報表"
    echo "   8) 打包問題資料      （有問題時，把產生的檔案寄給${CONTACT}）"
    echo "   9) 其他測試          （舊版：逐階加壓正式壓測、對話回應時間測試）"
    echo "  10) 調整設定          （回應時間門檻、失敗率門檻、休息時間）"
    echo "  11) 管理測試問句      （查看或修改每個情境的問句）"
    echo "  12) 使用說明          （每個按鈕在做什麼、目前的設定）"
    echo "   0) 離開"
    line
}

old_menu() {
    echo "  ${B}其他測試（舊版）${N}：查看進度、停止、報表一樣用主選單的 5、6、7。"
    echo
    echo "   1) 舊版試跑                （逐階加壓的第一階段，約 $(stage_minutes smoke) 分鐘）"
    echo "   2) 舊版正式壓測            （逐階加壓，約 $(stage_minutes full) 分鐘）"
    echo "   3) 對話回應時間測試 1 倍   （FAQ、業務混合，$(qa_peak_tps "$QA_STAGE_PLAN_X1") TPS，約 $(stage_minutes full "$QA_STAGE_PLAN_X1") 分鐘）"
    echo "   4) 對話回應時間測試 3 倍   （FAQ、業務混合，$(qa_peak_tps "$QA_STAGE_PLAN") TPS，約 $(stage_minutes full "$QA_STAGE_PLAN") 分鐘）"
    echo "   0) 回主選單"
    line
}

do_old_menu() {
    local choice
    while true; do
        header
        old_menu
        read -r -p "  請輸入數字：" choice || return
        case "$choice" in
            1) do_start smoke ;;
            2) do_start full ;;
            3) do_start qa1 ;;
            4) do_start qa3 ;;
            0|q|Q|'') return ;;
            *) ;;
        esac
    done
}

stage_minutes() { # stage_minutes smoke|full [STAGE_PLAN]：依目前設定估算一輪分鐘數（含收尾 1 分鐘）
    local entry id load hold ramp t=0
    IFS=';' read -r -a entries <<< "${2:-$STAGE_PLAN}"
    for entry in "${entries[@]}"; do
        IFS=':' read -r id load hold ramp <<< "$entry"
        t=$(awk -v t="$t" -v r="${ramp:-0}" -v h="${hold:-0}" 'BEGIN { print t + r + h }')  # 分鐘可以有小數
        [ "$1" = smoke ] && break
    done
    awk -v t="$t" 'BEGIN { m = t + 1; printf "%d", (m == int(m)) ? m : int(m) + 1 }'
}

qa_peak_tps() { # qa_peak_tps <STAGE_PLAN>：對話回應時間測試的最高 TPS（各階段的最大值）
    local entry id load max=0
    IFS=';' read -r -a entries <<< "$1"
    for entry in "${entries[@]}"; do
        IFS=':' read -r id load _ <<< "$entry"
        load="${load%tps}"
        awk -v a="$load" -v b="$max" 'BEGIN { exit !(a > b) }' && max="$load"
    done
    echo "$max"
}

# ---------- 1. 壓測前檢查 ----------
do_check() {
    local out fails warns
    echo
    echo "  檢查 control、每台 runner 與受測端的連線，約 1 分鐘，請稍候…"
    echo
    out="$("$K6CTL" preflight 2>&1)"
    echo "$out"
    fails="$(grep -c '✗' <<< "$out")"
    warns="$(grep -c '^ *! ' <<< "$out")"
    echo
    line
    if [ "$fails" -eq 0 ] && [ "$warns" -eq 0 ]; then
        ok "全部通過，可以開始測試。建議先選 2 試跑。"
    elif [ "$fails" -eq 0 ]; then
        warn "連線正常，但有 ${warns} 項提醒（上方標示 ! 的項目）："
        grep -q 'HTTP 403' <<< "$out" && warn "對話 API 回 403：受測端的 reCAPTCHA 尚未暫停，請聯絡受測端負責人。暫停前不要開始壓測。"
        grep -q '前端頁面 HTTP' <<< "$out" && grep -q '! 4' <<< "$out" && warn "前端頁面回應異常，請把上方畫面截圖給${CONTACT}。"
    else
        bad "有 ${fails} 項未通過（上方標示 ✗ 的項目），請依提示處理："
        grep -q 'SSH 失敗' <<< "$out" && bad "control 連不到 runner：確認每台 runner 都已開機，且安裝時有帶入 control 的公鑰。"
        grep -q 'HTTP 30[1237]' <<< "$out" && bad "受測端回 302：本機 IP 尚未加入受測端白名單，請聯絡受測端負責人。"
        grep -Eq '逾時或被拒絕|無法連線' <<< "$out" && bad "連不到受測端：防火牆未開出站，或需要經過 Proxy，請聯絡網路管理人員。"
        grep -q '無法解析' <<< "$out" && bad "DNS 解析失敗：請聯絡網路管理人員確認 DNS 設定。"
        grep -q 'NTP' <<< "$(grep '✗' <<< "$out")" && bad "時間未同步：請聯絡系統管理人員設定 NTP。"
        echo "  無法排除時，選 8 打包問題資料，把檔案寄給${CONTACT}。"
    fi
    pause
}

# ---------- 2／3. 開始 ----------
next_run_id() { # 今天的第幾輪：20261105-01、20261105-smoke-01
    local prefix n=1
    prefix="$(date +%Y%m%d)${1:+-$1}"
    while [ -e "${DATA_DIR}/runs/$(printf '%s-%02d' "$prefix" "$n")" ]; do n=$((n + 1)); done
    printf '%s-%02d' "$prefix" "$n"
}

do_start() { # do_start smoke|full|qa1|qa3
    local kind="$1" run rc=0 run_id plan="" args=() suite
    if suite="$(suite_running)"; then
        echo; bad "${suite} 還在執行中，同時只能有一組測試。要重新開始請先回主選單選 6 停止。"
        pause; return
    fi
    run="$(latest_run)"
    run_state "$run" || rc=$?
    if [ "$rc" -eq 1 ]; then
        echo; bad "${run} 還在執行中，同時只能有一輪壓測。要重新開始請先選 6 停止。"
        pause; return
    fi
    if [ "$kind" = smoke ]; then
        run_id="$(next_run_id smoke)"; args=(STAGE_SCOPE=smoke)
        echo
        echo "  ${B}試跑${N}：只跑第一階段（低流量），確認整個流程正常。"
    elif [ "$kind" = qa1 ] || [ "$kind" = qa3 ]; then
        if [ "$kind" = qa1 ]; then plan="$QA_STAGE_PLAN_X1"; else plan="$QA_STAGE_PLAN"; fi
        run_id="$(next_run_id "$kind")"; args=(TEST_TYPE=qa "STAGE_PLAN=${plan}")
        echo
        echo "  ${B}對話回應時間測試（${kind#qa} 倍）${N}：1 分鐘內爬升到 $(qa_peak_tps "$plan") TPS，之後固定負載到結束（不會自動停止）。"
        echo "  以一問一答為單位看回應時間（FAQ ≤ $((QA_FAQ_MAX_MS / 1000)) 秒、業務查詢 ≤ $((QA_BUSINESS_MAX_MS / 1000)) 秒）與失敗率。"
        warn "請確認：已先試跑成功、受測端負責人已同意、監控人員已就位。"
    else
        run_id="$(next_run_id)"
        echo
        echo "  ${B}正式壓測${N}：依序執行全部階段，流量會逐步加大到最高。"
        warn "請確認：已先試跑成功、受測端負責人已同意、監控人員已就位。"
    fi
    echo "  壓測編號：${run_id}"
    echo "  受測端　：${BASE_URL}"
    if [ -n "${plan:-}" ]; then
        echo "  預計時間：約 $(stage_minutes full "$plan") 分鐘"
    else
        echo "  預計時間：約 $(stage_minutes "$kind") 分鐘"
    fi
    confirm "即將開始壓測。" || { pause; return; }
    [ "$kind" != smoke ] && { confirm "再確認一次：開始$([ -n "${plan:-}" ] && echo 對話回應時間測試 || echo 正式壓測)？" || { pause; return; }; }
    echo
    if ! "$K6CTL" start "$run_id" "${args[@]}" --yes; then
        echo; bad "啟動失敗。請選 8 打包問題資料，把檔案寄給${CONTACT}。"
        pause; return
    fi
    echo
    ok "已開始。壓測在 runner 上執行，關閉這個視窗或斷線都不會中斷壓測。"
    echo "  之後可以選 5 查看進度；結束後選 7 產生報表。"
    if [ "$kind" = smoke ]; then
        echo
        read -r -p "  要在這裡等到試跑結束並自動產生報表嗎？（y＝等待，Enter＝回選單）" ans
        [ "$ans" = y ] || [ "$ans" = Y ] && { "$K6CTL" wait "$run_id"; show_result "$run_id"; }
    fi
    pause
}

# ---------- 4. 查看進度 ----------
show_result() { # 依各 runner 的 exit code 給白話結論
    local run="$1" out
    out="$("$K6CTL" status "$run" 2>&1)"
    echo
    line
    if grep -q '執行中' <<< "$out"; then
        echo "  $(progress_text "$run")"
    elif grep -q 'exit=0：' <<< "$out" && ! grep -Eq 'exit=[1-9]|異常' <<< "$out"; then
        ok "${run} 已結束：全部 runner 正常結束，回應時間與錯誤率都在門檻內。"
    elif grep -q 'exit=105' <<< "$out"; then
        warn "${run} 已手動停止。"
    elif grep -q 'exit=99' <<< "$out"; then
        warn "${run} 已結束：有指標超過門檻，或錯誤過多而自動停止。工具本身正常，請選 7 看報表了解哪一項超標。"
    else
        bad "${run} 有 runner 異常結束。請選 8 打包問題資料，把檔案寄給${CONTACT}。"
    fi
}

do_status_run() {
    local run
    run="$(latest_run)"
    [ -n "$run" ] || { echo; echo "  還沒有任何壓測紀錄。"; pause; return; }
    echo
    "$K6CTL" status "$run"
    show_result "$run"
    pause
}

# ---------- 5. 停止 ----------
do_stop_run() {
    local run rc=0
    run="$(latest_run)"
    run_state "$run" || rc=$?
    if [ "$rc" -ne 1 ] && [ "$rc" -ne 2 ]; then
        echo; echo "  目前沒有執行中的壓測。"; pause; return
    fi
    echo
    echo "  執行中：${run}　$(progress_text "$run")"
    confirm "停止後這一輪無法繼續，只能重新開始。" || { pause; return; }
    "$K6CTL" stop "$run"
    echo
    ok "已送出停止。約 1 分鐘後全部停下，之後選 7 產生報表（停止前的數據都會保留）。"
    pause
}

# ---------- 6. 報表 ----------
do_report_run() {
    local run rc=0
    run="$(latest_run)"
    [ -n "$run" ] || { echo; echo "  還沒有任何壓測紀錄。"; pause; return; }
    run_state "$run" || rc=$?
    echo
    [ "$rc" -eq 1 ] && warn "${run} 還在執行中，產生的是「截至目前」的報表。"
    echo "  產生 ${run} 的報表，請稍候…"
    if "$K6CTL" report "$run" > "${DATA_DIR}/runs/${run}/menu-report.log" 2>&1; then
        echo
        ok "報表已產生："
        echo "     ${B}${DATA_DIR}/runs/${run}/reports/latest.html${N}"
        if [ -f "${DATA_DIR}/runs/${run}/reports/qa-latest.html" ]; then
            echo "  對話回應時間報表（一問一答的回應時間與失敗率）："
            echo "     ${B}${DATA_DIR}/runs/${run}/reports/qa-latest.html${N}"
        fi
        echo "  請用貴司平常從伺服器下載檔案的方式取出，以瀏覽器開啟（不需要連網）。"
    else
        tail -5 "${DATA_DIR}/runs/${run}/menu-report.log"
        echo; bad "報表產生失敗。請選 8 打包問題資料，把檔案寄給${CONTACT}。"
    fi
    pause
}

# ---------- 7. 打包問題資料 ----------
# 收集判斷問題需要的資料（不含 k6 原始 CSV 與 sar 原始檔，檔案通常在幾 MB 內）
do_support() {
    local ts dir out run pf
    ts="$(date +%Y%m%d-%H%M%S)"
    dir="$(mktemp -d)/k6-support-${ts}"
    out="${DATA_DIR}/support/k6-support-$(hostname)-${ts}.tar.gz"
    mkdir -p "$dir" "${DATA_DIR}/support"
    echo
    echo "  收集資料中，約 1 分鐘…"
    {
        echo "# $(date -Iseconds) $(hostname)"
        cat /etc/redhat-release /etc/os-release 2>/dev/null | head -3
        uname -a
        command -v getenforce >/dev/null && echo "SELinux: $(getenforce)"
        echo; df -h "$DATA_DIR"; echo; free -m
        echo; echo "## 程式版本"; ls -l --time-style=long-iso "${APP_DIR}/onprem/bin/" "${APP_DIR}/runner/k6/"
        echo; echo "## k6ctl check"; "$K6CTL" check 2>&1
    } > "${dir}/system.txt" 2>&1
    cp "$CONF_FILE" "${dir}/stress.env" 2>/dev/null
    pf="$(ls -1td "${DATA_DIR}"/preflight/*/ 2>/dev/null | head -1)"
    [ -n "$pf" ] && cp -r "$pf" "${dir}/preflight-latest"
    for run in $(ls -1t "${DATA_DIR}/runs" 2>/dev/null | head -2); do
        "$K6CTL" collect "$run" > /dev/null 2>&1 || true
        (cd "${DATA_DIR}/runs" && find "$run" -type f \( -name '*.log' -o -name '*.txt' -o -name '*.json' -o -name '*.env' \
            -o -name 'k6.exit' -o -name 'latest.html' \) -print0 | rsync -a --from0 --files-from=- ./ "${dir}/runs/")
    done
    for run in $(ls -1t "${DATA_DIR}/suites" 2>/dev/null | head -2); do
        mkdir -p "${dir}/suites/${run}"
        (cd "${DATA_DIR}/suites/${run}" && cp -r ./*.env ./*.log stop-requested reports "${dir}/suites/${run}/" 2>/dev/null)
        for p in A B; do
            "$K6CTL" collect "${run}-${p}" > /dev/null 2>&1 || true
            [ -d "${DATA_DIR}/runs/${run}-${p}" ] && (cd "${DATA_DIR}/runs" && find "${run}-${p}" -type f \( -name '*.log' -o -name '*.txt' \
                -o -name '*.json' -o -name '*.env' -o -name 'k6.exit' \) -print0 | rsync -a --from0 --files-from=- ./ "${dir}/runs/")
        done
    done
    tar -C "$(dirname "$dir")" -czf "$out" "$(basename "$dir")"
    rm -rf "$(dirname "$dir")"
    echo
    ok "已打包：${B}${out}${N}（$(du -h "$out" | cut -f1)）"
    echo "  請取出這個檔案寄給${CONTACT}，並簡單說明發生了什麼事（做了哪個選項、看到什麼畫面）。"
    pause
}

# ---------- v3 分開測試（腳本甲 業務查詢 → 休息 → 腳本乙 FAQ 問答 → 合併報表） ----------
suite_running() { "$K6SUITE" running 2>/dev/null; }
latest_suite() { ls -1t "${DATA_DIR}/suites" 2>/dev/null | head -1; }

# 最近一次是 v3 測試（suite）還是舊版測試（run）：比較兩者開始時寫的設定檔
latest_kind() {
    local s r
    s="$(latest_suite)"
    r="$(ls -1t "${DATA_DIR}/runs" 2>/dev/null | grep -Ev -- '-v3.*-[AB]$' | head -1)"
    if [ -z "$s" ]; then echo run; return; fi
    if [ -z "$r" ]; then echo suite; return; fi
    if [ "${DATA_DIR}/runs/${r}/run.env" -nt "${DATA_DIR}/suites/${s}/suite.env" ]; then echo run; else echo suite; fi
}

plan_for() { # plan_for <smoke|x1|x3> <A|B>
    case "$1" in
        smoke) echo "$V3_PLAN_SMOKE" ;;
        x1) [ "$2" = A ] && echo "$V3_PLAN_X1_A" || echo "$V3_PLAN_X1_B" ;;
        x3) [ "$2" = A ] && echo "$V3_PLAN_X3_A" || echo "$V3_PLAN_X3_B" ;;
    esac
}

part_minutes() { # 一支腳本：爬升＋持續＋收尾 1 分鐘
    echo $(( $(stage_minutes full "$1") ))
}

suite_minutes() { # 整組：A＋休息＋B＋報表約 2 分鐘
    local a b
    a=$(part_minutes "$(plan_for "$1" A)"); b=$(part_minutes "$(plan_for "$1" B)")
    awk -v a="$a" -v b="$b" -v g="${V3_GAP_MIN:-2}" 'BEGIN { printf "%d", a + g + b + 2 }'
}

case_list() { # case_list 'B2:28;B5:2' → B2 FAQ 問答 93%、B5 Model Armor 攔截 7%
    local entry id w total=0 out=""
    IFS=';' read -r -a entries <<< "$1"
    for entry in "${entries[@]}"; do total=$(awk -v t="$total" -v w="${entry#*:}" 'BEGIN { print t + w }'); done
    for entry in "${entries[@]}"; do
        id="${entry%%:*}"; w="${entry#*:}"
        case "$id" in
            B2) name="FAQ 問答" ;; B2-2) name="FAQ intent" ;; B3) name="多輪對話" ;; B4) name="知識庫以外問題" ;;
            B5) name="Model Armor 攔截" ;; C1) name="查看 ETF 清單" ;; *) name="" ;;
        esac
        out+="${out:+、}${id}${name:+ ${name}} $(awk -v w="$w" -v t="$total" 'BEGIN { printf "%.0f", w / t * 100 }')%"
    done
    echo "$out"
}

dur_text() { # 3m → 3 分鐘、20s → 20 秒（k6 的時間格式）
    case "$1" in
        *m) echo "${1%m} 分鐘" ;; *s) echo "${1%s} 秒" ;; *h) echo "${1%h} 小時" ;; *) echo "$1" ;;
    esac
}

plan_words() { # x3:354tps:10:1 → 爬升 1 分鐘到 354 TPS，固定負載 10 分鐘
    local entry id load hold ramp out=""
    IFS=';' read -r -a entries <<< "$1"
    for entry in "${entries[@]}"; do
        IFS=':' read -r id load hold ramp <<< "$entry"
        out+="${out:+；}爬升 ${ramp:-0} 分鐘到 ${load%tps} TPS，固定負載 ${hold} 分鐘"
    done
    echo "$out"
}

do_v3() { # do_v3 smoke|x1|x3
    local kind="$1" run rc=0 suite abort="${V3_ABORT_DEFAULT:-false}" ans title start_flag
    if suite="$(suite_running)"; then
        echo; bad "${suite} 還在執行中，同時只能有一組測試。可以選 5 查看進度，或選 6 停止。"
        pause; return
    fi
    run="$(latest_run)"
    run_state "$run" || rc=$?
    if [ "$rc" -eq 1 ]; then
        echo; bad "舊版測試 ${run} 還在執行中，同時只能有一組測試。要重新開始請先選 6 停止。"
        pause; return
    fi
    case "$kind" in
        smoke) title="試跑 甲→乙（低流量）" ;;
        x1) title="正式測試 1 倍" ;;
        x3) title="正式測試 3 倍" ;;
    esac
    echo
    echo "  ${B}${title}${N}：以下步驟會自動依序完成，中途不需要操作。"
    echo
    echo "   ① 腳本甲 業務查詢（$(case_list "$V3_A_WEIGHTS")）"
    echo "      $(plan_words "$(plan_for "$kind" A)")；門檻 p${V3_LATENCY_PCT} ≤ $(awk -v m="$V3_A_MAX_MS" 'BEGIN { printf "%g", m / 1000 }') 秒"
    echo "   ② 休息 ${V3_GAP_MIN} 分鐘"
    echo "   ③ 腳本乙 FAQ 問答（$(case_list "$V3_B_WEIGHTS")）"
    echo "      $(plan_words "$(plan_for "$kind" B)")；門檻 p${V3_LATENCY_PCT} ≤ $(awk -v m="$V3_B_MAX_MS" 'BEGIN { printf "%g", m / 1000 }') 秒"
    echo "   ④ 產生合併報表（甲、乙分開呈現）"
    echo
    echo "  受測端　：${BASE_URL}"
    echo "  預計時間：約 $(suite_minutes "$kind") 分鐘，約 $(date -d "+$(suite_minutes "$kind") min" +%H:%M) 完成"
    if [ "$kind" != smoke ]; then
        echo
        echo "  遇到嚴重異常時要自動停止嗎？"
        if [ "$abort" = true ]; then
            echo "   1) 自動停止：開始 $(dur_text "$V3_ABORT_DELAY") 後，失敗率超過 $(awk -v r="$V3_ABORT_FAIL_RATE" 'BEGIN { printf "%g", r * 100 }')% 就停止該支腳本（預設）"
            echo "   2) 不停，一律跑完"
            read -r -p "  請選擇 [1]：" ans
            [ "$ans" = 2 ] && abort=false
        else
            echo "   1) 不停，一律跑完（預設，直接按 Enter）"
            echo "   2) 自動停止：開始 $(dur_text "$V3_ABORT_DELAY") 後，失敗率超過 $(awk -v r="$V3_ABORT_FAIL_RATE" 'BEGIN { printf "%g", r * 100 }')% 就停止該支腳本"
            read -r -p "  請選擇 [1]：" ans
            [ "$ans" = 2 ] && abort=true
        fi
        if [ "$abort" = true ]; then
            echo "  → 自動停止：開啟。腳本甲被自動停止時，休息後照樣跑腳本乙。"
        else
            echo "  → 自動停止：關閉，甲、乙都會跑完。"
        fi
        warn "請確認：已先試跑成功、受測端負責人已同意、監控人員已就位。"
    fi
    confirm "即將開始${title}。" || { pause; return; }
    [ "$kind" != smoke ] && { confirm "再確認一次：開始${title}？" || { pause; return; }; }
    [ "$abort" = true ] && start_flag=--abort || start_flag=--no-abort
    echo
    echo "  啟動中…"
    if ! suite="$("$K6SUITE" start "$kind" "$start_flag" 2>&1)"; then
        echo "$suite"
        echo; bad "啟動失敗。請選 8 打包問題資料，把檔案寄給${CONTACT}。"
        pause; return
    fi
    ok "已開始，測試編號 ${suite}。測試在背景執行，關閉這個視窗或斷線都不會中斷。"
    sleep 2
    do_watch "$suite"
}

# 進度畫面：每 10 秒自動更新；按 Enter 或 Ctrl+C 回到選單（測試照樣在背景執行）
do_watch() {
    local suite="${1:-$(latest_suite)}" leave=false phase
    [ -n "$suite" ] || { echo; echo "  還沒有任何測試紀錄。"; pause; return; }
    trap 'leave=true' INT
    while ! $leave; do
        clear 2>/dev/null || true
        line
        echo "  ${B}新阿發 測試進度${N}　　$(date '+%Y-%m-%d %H:%M:%S')"
        line
        "$K6SUITE" progress "$suite"
        phase="$(grep '^PHASE=' "${DATA_DIR}/suites/${suite}/state.env" 2>/dev/null | cut -d= -f2)"
        line
        if [ "$phase" = done ]; then
            echo "  已結束。報表請用瀏覽器開啟（不需要連網）：可以用貴司平常從伺服器下載檔案的方式取出。"
            trap - INT
            pause
            return
        fi
        echo "  每 10 秒自動更新。按 Enter 回到選單（${B}測試會繼續在背景執行${N}，之後選 5 可以回來看）。"
        # 0＝按了 Enter、1＝輸入已關閉：回選單；> 128＝10 秒到了（或 Ctrl+C，由 trap 處理）：繼續更新
        read -r -t 10 _
        [ $? -le 128 ] && leave=true
    done
    trap - INT
}

do_progress() {
    if suite="$(suite_running)" || [ "$(latest_kind)" = suite ]; then do_watch "${suite:-$(latest_suite)}"; else do_status_run; fi
}

do_stop() {
    local suite run rc=0
    if suite="$(suite_running)"; then
        echo
        echo "  執行中：${suite}　$("$K6SUITE" brief "$suite")"
        echo "  停止後甲、乙都不會再跑（還沒跑的腳本不會開始），會用停止前的數據產生報表。"
        confirm "停止後這一組無法繼續，只能重新開始。" || { pause; return; }
        "$K6SUITE" stop "$suite"
        echo
        ok "已送出停止。約 1～2 分鐘後停下並產生報表，可以留在進度畫面等候。"
        sleep 2
        do_watch "$suite"
        return
    fi
    run="$(latest_run)"
    run_state "$run" || rc=$?
    if [ "$rc" -eq 1 ] || [ "$rc" -eq 2 ]; then do_stop_run; return; fi
    echo; echo "  目前沒有執行中的測試。"; pause
}

do_report() {
    local suite sdir rpt
    if [ "$(latest_kind)" != suite ] && ! suite_running > /dev/null; then do_report_run; return; fi
    suite="$(suite_running)" || suite="$(latest_suite)"
    sdir="${DATA_DIR}/suites/${suite}"
    rpt="${sdir}/reports/report-${suite}.html"
    echo
    if suite_running > /dev/null; then
        warn "${suite} 還在執行中，全部跑完後會自動產生報表。"
        read -r -p "  要先產生「截至目前」的報表嗎？（y＝產生，Enter＝回選單）" ans
        [ "$ans" = y ] || [ "$ans" = Y ] || { return; }
    elif [ -f "$rpt" ]; then
        ok "${suite} 的報表："
        echo "     ${B}${rpt}${N}"
        echo "  請用貴司平常從伺服器下載檔案的方式取出，以瀏覽器開啟（不需要連網）。"
        echo
        read -r -p "  要重新產生嗎？（y＝重新產生，Enter＝回選單）" ans
        [ "$ans" = y ] || [ "$ans" = Y ] || { return; }
    fi
    echo "  產生 ${suite} 的報表，請稍候…"
    if "$K6SUITE" report "$suite" > "${sdir}/menu-report.log" 2>&1; then
        echo; ok "報表已產生："
        echo "     ${B}${rpt}${N}"
        echo "  請用貴司平常從伺服器下載檔案的方式取出，以瀏覽器開啟（不需要連網）。"
    else
        tail -5 "${sdir}/menu-report.log"
        echo; bad "報表產生失敗。請選 8 打包問題資料，把檔案寄給${CONTACT}。"
    fi
    pause
}

# ---------- 10. 調整設定（門檻、休息時間） ----------
# 寫進客戶自己的 /etc/k6-stress/stress.env（覆蓋 defaults.env）；更新程式版本不會被蓋掉。改完從下一組測試開始生效
SETTINGS_LOG="${DATA_DIR}/settings-history.log"
# 代號|名稱|單位|換算（ms＝輸入秒存毫秒、pct＝輸入 % 存比例、raw＝原值）|最小|最大
SETTINGS=(
    "V3_A_MAX_MS|腳本甲 業務查詢 回應時間門檻（p95）|秒|ms|1|120"
    "V3_B_MAX_MS|腳本乙 FAQ 問答 回應時間門檻（p95）|秒|ms|1|120"
    "V3_FAIL_RATE|對話失敗率門檻|%|pct|0|100"
    "V3_ABORT_FAIL_RATE|自動停止的失敗率（開始前選擇開啟時才用）|%|pct|0.1|100"
    "V3_GAP_MIN|甲、乙之間休息時間|分鐘|raw|0|30"
)

to_display() { # to_display <換算> <存的值>
    case "$1" in
        ms) awk -v v="$2" 'BEGIN { printf "%g", v / 1000 }' ;;
        pct) awk -v v="$2" 'BEGIN { printf "%g", v * 100 }' ;;
        *) echo "$2" ;;
    esac
}

to_stored() { # to_stored <換算> <輸入的值>
    case "$1" in
        ms) awk -v v="$2" 'BEGIN { printf "%d", v * 1000 + 0.5 }' ;;
        pct) awk -v v="$2" 'BEGIN { printf "%g", v / 100 }' ;;
        *) echo "$2" ;;
    esac
}

default_of() { (set -a; . "${APP_DIR}/onprem/config/defaults.env"; eval "echo \"\${$1}\""); }

conf_set() { # conf_set <代號> <值>：stress.env 有這行就改，沒有就加在最後
    if grep -q "^$1=" "$CONF_FILE"; then
        sed -i "s|^$1=.*|$1=$2|" "$CONF_FILE"
    else
        [ -s "$CONF_FILE" ] && [ -n "$(tail -c1 "$CONF_FILE")" ] && echo >> "$CONF_FILE"  # 最後一行沒有換行時先補上
        printf '%s=%s\n' "$1" "$2" >> "$CONF_FILE"
    fi
}

settings_log() { echo "$(date '+%Y-%m-%d %H:%M:%S') ${SUDO_USER:-$(id -un)} $*" >> "$SETTINGS_LOG"; }

do_settings() {
    local choice i item key name unit conv min max cur def input stored sep
    while true; do
        load_config
        clear 2>/dev/null || true
        line
        echo "  ${B}調整設定${N}　改完從${B}下一組測試${N}開始生效，正在跑的測試不受影響。"
        echo "  報表會列出每一組測試當時用的設定。"
        line
        printf '       %s  %s  %s\n' "$(pad '項目' 44)" "$(pad '目前值' 10)" "預設值"
        for i in "${!SETTINGS[@]}"; do
            IFS='|' read -r key name unit conv min max <<< "${SETTINGS[$i]}"
            sep=" "; [ "$unit" = % ] && sep=""
            cur="$(to_display "$conv" "${!key}")${sep}${unit}"; def="$(to_display "$conv" "$(default_of "$key")")${sep}${unit}"
            [ "$cur" != "$def" ] && cur="${Y}${cur}${N}"
            printf '   %2d) %s  %s  %s\n' $((i + 1)) "$(pad "$name" 44)" "$(pad "$cur" 10)" "$def"
        done
        echo
        echo "    9) 全部恢復預設值"
        echo "    0) 回主選單"
        line
        [ -f "$SETTINGS_LOG" ] && echo "  最近一次修改：$(tail -1 "$SETTINGS_LOG")"
        read -r -p "  請輸入要調整的項目：" choice || return
        case "$choice" in
            0|q|Q|'') return ;;
            9)
                confirm "全部恢復預設值（${#SETTINGS[@]} 項）。" || { pause; continue; }
                for item in "${SETTINGS[@]}"; do
                    key="${item%%|*}"
                    sed -i "/^${key}=/d" "$CONF_FILE"
                done
                settings_log "全部恢復預設值"
                ok "已恢復預設值。"; pause ;;
            [1-9])
                [ "$choice" -le "${#SETTINGS[@]}" ] || continue
                IFS='|' read -r key name unit conv min max <<< "${SETTINGS[$((choice - 1))]}"
                cur="$(to_display "$conv" "${!key}")"
                echo
                echo "  ${B}${name}${N}"
                echo "  目前 ${cur} ${unit}（預設 $(to_display "$conv" "$(default_of "$key")") ${unit}），可輸入 ${min}～${max}"
                read -r -p "  請輸入新的值（單位：${unit}；直接按 Enter＝不改）：" input || return
                input="${input// /}"; input="${input%${unit}}"
                [ -n "$input" ] || continue
                if ! [[ "$input" =~ ^[0-9]+(\.[0-9]+)?$ ]] || ! awk -v v="$input" -v a="$min" -v b="$max" 'BEGIN { exit !(v >= a && v <= b) }'; then
                    bad "「${input}」不是 ${min}～${max} 之間的數字，沒有修改。"; pause; continue
                fi
                confirm "${name}：${cur} ${unit} → ${input} ${unit}。" || { pause; continue; }
                stored="$(to_stored "$conv" "$input")"
                conf_set "$key" "$stored"
                settings_log "${key} ${!key} → ${stored}（${name} ${cur} → ${input} ${unit}）"
                ok "已修改，下一組測試開始生效。"; pause ;;
        esac
    done
}

# ---------- 11. 管理測試問句 ----------
# 改的是客戶自己的 /etc/k6-stress/questions.json（第一次修改時從程式附的問句複製）；k6ctl start 會用這份同步到 runner
QUESTIONS_FILE="$(dirname "$CONF_FILE")/questions.json"
DEFAULT_QUESTIONS="${APP_DIR}/runner/k6/data/questions.json"
CASES=("B1|開場問候" "B2-2|FAQ intent" "C1|查看 ETF 清單" "B2|FAQ 問答" "B3|多輪對話" "B4|知識庫以外問題" "B5|Model Armor 攔截")

qpy() { # qpy <動作> <參數…>：讀寫問句 JSON（格式檢查、每個情境至少一句）
    local py="${APP_DIR}/venv/bin/python3"
    [ -x "$py" ] || py=python3
    "$py" - "$@" <<'PY'
import json, os, sys
act, path = sys.argv[1], sys.argv[2]
with open(path, encoding="utf-8") as f:
    q = json.load(f)
def save():
    keys = [k for k in q if k != "_note"]
    lines = ["{"] + ([f'  "_note": {json.dumps(q["_note"], ensure_ascii=False)},'] if "_note" in q else [])
    lines += [f'  {json.dumps(k, ensure_ascii=False)}: {json.dumps(q[k], ensure_ascii=False)}' + ("," if i < len(keys) - 1 else "") for i, k in enumerate(keys)]
    tmp = path + ".tmp"
    with open(tmp, "w", encoding="utf-8") as f:
        f.write("\n".join(lines + ["}"]) + "\n")
    os.replace(tmp, path)
if act == "count":
    print(len(q.get(sys.argv[3], [])))
elif act == "list":
    for i, x in enumerate(q.get(sys.argv[3], []), 1):
        print(f"     {i}. {x}")
else:
    case, items = sys.argv[3], q.setdefault(sys.argv[3], [])
    if act == "add":
        items.append(sys.argv[4])
    elif act in ("set", "del"):
        i = int(sys.argv[4]) - 1
        if not 0 <= i < len(items):
            sys.exit("沒有這個編號")
        if act == "set":
            items[i] = sys.argv[5]
        else:
            if len(items) <= 1:
                sys.exit("每個情境至少要留一句，不能刪除最後一句")
            items.pop(i)
    save()
PY
}

case_used_in() { # 這個情境用在哪支腳本
    local id="$1"
    [ "$id" = B1 ] && { echo "每位訪客開頭（不計入統計）"; return; }
    grep -Eq "(^|;)${id}:" <<< "$V3_A_WEIGHTS" && { echo "腳本甲"; return; }
    grep -Eq "(^|;)${id}:" <<< "$V3_B_WEIGHTS" && { echo "腳本乙"; return; }
    echo "目前沒有使用"
}

case_hint() {
    case "$1" in
        B1) echo "訪客進入聊天時自動送出的招呼。" ;;
        B2-2) echo "會觸發 FAQ intent（業務查詢）的問句。" ;;
        C1) echo "會帶出 ETF 相關業務查詢的問句。" ;;
        B2) echo "一般 FAQ 問題（由 AI 生成回覆）。" ;;
        B3) echo "多輪對話的追問；每則提問從中隨機抽一句。" ;;
        B4) echo "知識庫以外的問題（例如閒聊），AI 應回覆無法回答。" ;;
        B5) echo "${Y}必須是會被 Model Armor 攔截的內容，否則每一則都會算失敗。${N}" ;;
    esac
}

read_question() { # read_question <提示>：讀一行問句，檢查不是空的、不太長
    local text
    read -r -p "  $1" text || return 1
    text="$(sed 's/^[[:space:]]*//; s/[[:space:]]*$//' <<< "$text")"
    [ -n "$text" ] || return 1
    if [ "${#text}" -gt 200 ]; then bad "問句太長（超過 200 字），沒有修改。"; return 1; fi
    QUESTION="$text"
}

do_questions() {
    local choice i id name src
    while true; do
        load_config
        clear 2>/dev/null || true
        line
        echo "  ${B}管理測試問句${N}　改完從${B}下一組測試${N}開始生效（甲乙測試、舊版測試都會用到）。"
        if [ -f "$QUESTIONS_FILE" ]; then
            src="$QUESTIONS_FILE"
            echo "  目前使用：${Y}已修改的問句${N}（最後修改 $(date -r "$QUESTIONS_FILE" '+%Y-%m-%d %H:%M')）"
        else
            src="$DEFAULT_QUESTIONS"
            echo "  目前使用：程式附的預設問句"
        fi
        line
        printf '       %s  %s  %s\n' "$(pad '情境' 26)" "$(pad '問句數' 6)" "用在"
        for i in "${!CASES[@]}"; do
            id="${CASES[$i]%%|*}"; name="${CASES[$i]#*|}"
            printf '   %2d) %s  %s  %s\n' $((i + 1)) "$(pad "${id} ${name}" 26)" "$(pad "$(qpy count "$src" "$id")" 6)" "$(case_used_in "$id")"
        done
        echo
        echo "    9) 恢復預設問句"
        echo "    0) 回主選單"
        line
        echo "  改完建議先在新阿發網頁實際問一次確認回應正常，再選主選單 2 試跑。"
        read -r -p "  請輸入要查看或修改的情境：" choice || return
        case "$choice" in
            0|q|Q|'') return ;;
            9)
                [ -f "$QUESTIONS_FILE" ] || { echo; echo "  目前就是預設問句。"; pause; continue; }
                confirm "恢復預設問句（目前修改過的問句會備份成 questions.json.bak）。" || { pause; continue; }
                mv "$QUESTIONS_FILE" "${QUESTIONS_FILE}.bak"
                settings_log "問句恢復預設（舊的備份在 ${QUESTIONS_FILE}.bak）"
                ok "已恢復預設問句。"; pause ;;
            [1-7]) do_question_case "${CASES[$((choice - 1))]}" ;;
        esac
    done
}

do_question_case() { # do_question_case "<代號>|<名稱>"
    local id="${1%%|*}" name="${1#*|}" act n src err
    while true; do
        src="$DEFAULT_QUESTIONS"; [ -f "$QUESTIONS_FILE" ] && src="$QUESTIONS_FILE"
        clear 2>/dev/null || true
        line
        echo "  ${B}${id} ${name}${N}（$(case_used_in "$id")）"
        echo "  $(case_hint "$id")"
        line
        qpy list "$src" "$id"
        echo
        echo "   a) 新增問句   e) 修改問句   d) 刪除問句   0) 回上一層"
        line
        read -r -p "  請選擇：" act || return
        case "$act" in
            0|q|Q|'') return ;;
            a|A|e|E|d|D)
                # 第一次修改：從預設問句複製一份到客戶自己的設定目錄
                [ -f "$QUESTIONS_FILE" ] || cp "$DEFAULT_QUESTIONS" "$QUESTIONS_FILE"
                case "$act" in
                    a|A)
                        read_question "請輸入新的問句（直接按 Enter＝取消）：" || continue
                        err="$(qpy add "$QUESTIONS_FILE" "$id" "$QUESTION" 2>&1)" && settings_log "問句 ${id} 新增：${QUESTION}" ;;
                    e|E)
                        read -r -p "  要修改第幾句：" n || return
                        [[ "$n" =~ ^[0-9]+$ ]] || continue
                        read_question "請輸入修改後的問句（直接按 Enter＝取消）：" || continue
                        err="$(qpy set "$QUESTIONS_FILE" "$id" "$n" "$QUESTION" 2>&1)" && settings_log "問句 ${id} 第 ${n} 句改為：${QUESTION}" ;;
                    d|D)
                        read -r -p "  要刪除第幾句：" n || return
                        [[ "$n" =~ ^[0-9]+$ ]] || continue
                        confirm "刪除 ${id} 第 ${n} 句。" || { pause; continue; }
                        err="$(qpy del "$QUESTIONS_FILE" "$id" "$n" 2>&1)" && settings_log "問句 ${id} 刪除第 ${n} 句" ;;
                esac
                if [ -n "${err:-}" ]; then bad "$(tail -1 <<< "$err")"; else ok "已儲存，下一組測試開始生效。"; fi
                err=""
                pause ;;
        esac
    done
}

# ---------- 12. 使用說明 ----------
do_help() {
    load_config
    clear 2>/dev/null || true
    line
    echo "  ${B}使用說明（1/2）：怎麼操作${N}"
    line
    cat <<EOF
  建議順序：1 壓測前檢查 → 2 試跑 → 3 或 4 正式測試 → 7 取得報表

   1) 壓測前檢查   確認 control、runner 與受測端的連線。每次測試前先做，約 1 分鐘。
   2) 試跑 甲→乙   低流量把整個流程跑一遍（含報表），確認一切正常再做正式測試。
   3) 正式測試 1 倍 / 4) 正式測試 3 倍
                   依序自動完成：腳本甲 業務查詢 → 休息 → 腳本乙 FAQ 問答 → 合併報表。
                   在背景執行，關閉視窗或斷線都不會中斷；開始前可選擇是否自動停止。
   5) 查看進度     目前跑到哪支腳本、哪個階段、預計幾點完成；每 10 秒自動更新。
   6) 停止測試     整組停止（還沒跑的腳本不會開始），用停止前的數據產生報表。
   7) 取得報表     顯示報表檔案位置；也可以重新產生。報表用瀏覽器開啟，不需要連網。
   8) 打包問題資料 有問題時把產生的檔案寄給 ${CONTACT}。
   9) 其他測試     舊版測試（逐階加壓正式壓測、對話回應時間測試）。
  10) 調整設定     回應時間門檻、失敗率門檻、休息時間。
  11) 管理測試問句 查看或修改每個情境的問句。
EOF
    echo
    read -r -p "  按 Enter 看下一頁（目前的設定）…" _ || return
    clear 2>/dev/null || true
    line
    echo "  ${B}使用說明（2/2）：目前的設定${N}（在 10、11 可以修改）"
    line
    echo "  腳本甲 業務查詢：$(case_list "$V3_A_WEIGHTS")"
    echo "      負載：1 倍 $(plan_words "$V3_PLAN_X1_A")；3 倍 $(plan_words "$V3_PLAN_X3_A")"
    echo "      門檻：回應時間 p${V3_LATENCY_PCT} ≤ $(to_display ms "$V3_A_MAX_MS") 秒、對話失敗率 ≤ $(to_display pct "$V3_FAIL_RATE")%"
    echo "  腳本乙 FAQ 問答：$(case_list "$V3_B_WEIGHTS")"
    echo "      負載：1 倍 $(plan_words "$V3_PLAN_X1_B")；3 倍 $(plan_words "$V3_PLAN_X3_B")"
    echo "      門檻：回應時間 p${V3_LATENCY_PCT} ≤ $(to_display ms "$V3_B_MAX_MS") 秒、對話失敗率 ≤ $(to_display pct "$V3_FAIL_RATE")%"
    echo "  甲、乙之間休息：${V3_GAP_MIN} 分鐘"
    echo "  自動停止（開始前選擇）：開啟時，開始 $(dur_text "$V3_ABORT_DELAY") 後失敗率超過 $(to_display pct "$V3_ABORT_FAIL_RATE")% 就停止該支腳本"
    echo "  問句：$([ -f "$QUESTIONS_FILE" ] && echo "已修改（${QUESTIONS_FILE}）" || echo "程式附的預設問句")"
    echo
    echo "  判定：回應時間 p${V3_LATENCY_PCT} 與對話失敗率兩項都在門檻內才算「通過」。"
    echo "  p${V3_LATENCY_PCT}＝${V3_LATENCY_PCT}% 的對話都在這個時間內回覆；只看爬升到目標 TPS 之後的固定負載期間。"
    echo "  報表位置：${DATA_DIR}/suites/<測試編號>/reports/report-<測試編號>.html"
    pause
}

# 中文字佔兩格：依顯示寬度補空白（去掉顏色碼再算）
pad() {
    local plain w
    plain="$(sed 's/\x1b\[[0-9;]*m//g' <<< "$1")"
    w="$(printf '%s' "$plain" | LC_ALL=C.UTF-8 wc -L 2>/dev/null)" || w=${#plain}
    printf '%s%*s' "$1" $(( $2 - w > 0 ? $2 - w : 0 )) ''
}

# ---------- 主程式 ----------
load_config
while true; do
    header
    menu
    read -r -p "  請輸入數字：" choice || { echo; exit 0; }  # 輸入已關閉（例如斷線）
    case "$choice" in
        1) do_check ;;
        2) do_v3 smoke ;;
        3) do_v3 x1 ;;
        4) do_v3 x3 ;;
        5) do_progress ;;
        6) do_stop ;;
        7) do_report ;;
        8) do_support ;;
        9) do_old_menu ;;
        10) do_settings ;;
        11) do_questions ;;
        12|h|H|help|'?') do_help ;;
        0|q|Q) echo; exit 0 ;;
        *) ;;
    esac
done

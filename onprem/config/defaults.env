# 地端壓測的預設參數（隨程式版本控管，不要在 VM 上改這個檔）
# 依「新阿發_壓力測試_地端執行環境規劃_v1.0」。環境相關的值（受測端、runner IP）寫在 /etc/k6-stress/stress.env，會覆蓋這裡的值。
# 格式：shell 變數（k6ctl 以 bash source 讀取）；含分號或空白的值要加單引號。參數說明見 runner/k6/README.md。

# ---------- 負載模型（規劃 p.6～7） ----------
# STAGE_PLAN 以聊天 API 的每秒請求數（tps）定義；每段對話＝開場問候＋8～11 則訊息，平均 10.5 次請求
# 階段：S0 Smoke 5 → S1 Baseline 30 → S2 1 倍 118 → S3 3 倍 354 → S4 Recovery 30 TPS，每階爬升 1 分鐘
STAGE_PLAN='s0:5tps:10:1;s1:30tps:15:1;s2:118tps:30:1;s3:354tps:60:1;s4:30tps:15:1'
# 1 倍的每秒新開對話數＝118 TPS ÷ 10.5（只影響 log 與通知中的「倍數」顯示，階段流量以 STAGE_PLAN 的 tps 為準）
BASE_CONV_RATE=11.24
MSGS_MIN=8
MSGS_MAX=11
# 訊息之間停頓 5～15 秒
THINK_TIME_S=10
THINK_JITTER=0.5
# VU 估算：每段對話約 210 秒 → S3 合計約 7,080 VU；回應變慢時最多約 10,500（每台約 3,500）
CONV_P95_S=210
MAX_VUS=10500

# ---------- 業務情境：「業務情境組合」黃色列（與 Cloud Run 版相同） ----------
# B1 開場問候為每段對話開頭；B2、B2-2、B3、B4、B5、C1 依權重抽選；A4 Token 續期需要登入，不在腳本流程內
SCENARIO_WEIGHTS='B2:28;B2-2:36;B3:15;B4:5;B5:2;C1:12'

# ---------- 對話回應時間測試（TEST_TYPE=qa；k6menu 8／9） ----------
# 依客戶 2026-11-12 回覆：以使用者提問的一問一答為單位，1 倍、3 倍各跑一輪，1 分鐘爬升後固定負載 10 分鐘
#   1 倍：k6ctl start <RUN_ID> TEST_TYPE=qa STAGE_PLAN=x1:118tps:10:1
#   3 倍：k6ctl start <RUN_ID> TEST_TYPE=qa（沒指定 STAGE_PLAN 時用 QA_STAGE_PLAN）
# TPS＝聊天 API 每秒請求數（含開場問候，與上方 STAGE_PLAN 的定義相同）；開場問候照送，但不計入對話統計
QA_STAGE_PLAN='x3:354tps:10:1'
QA_STAGE_PLAN_X1='x1:118tps:10:1'
# 回應時間門檻（毫秒）：FAQ 含 AI 思考時間 8 秒、一般業務查詢 2 秒；以 p95 判定
QA_FAQ_MAX_MS=8000
QA_BUSINESS_MAX_MS=2000
QA_LATENCY_PCT=95
# 失敗率（對話失敗筆數 ÷ 對話總筆數）門檻
QA_FAIL_RATE=0.005
# 不自動停止，一律打完（客戶回覆：有問題時比較好找問題節點）；true＝失敗率 > ABORT_ERROR_RATE 時停止
QA_ABORT=false
# VU：預設最高 TPS × 20／× 30（354 TPS 時 7,080／10,620，與正式壓測相同量級）
# QA_PRE_VUS=
# QA_MAX_VUS=

# ---------- v3 分開測試（k6menu 2～4；客戶 2026-11-13 確認） ----------
# 腳本 A 業務查詢 → 休息 V3_GAP_MIN 分鐘 → 腳本 B FAQ 問答 → 合併報表（一份 HTML，A、B 分區）
# 由 onprem/bin/k6suite 在 control 背景串接；報表在 /var/lib/k6-stress/suites/<測試編號>/reports/
# 情境（格式同 SCENARIO_WEIGHTS）：A 只能放業務查詢類、B 只能放 FAQ 類，混到別類腳本會直接報錯
V3_A_WEIGHTS='B2-2:36;C1:12'
V3_B_WEIGHTS='B2:28;B3:15;B4:5;B5:2'
# 負載（格式同 STAGE_PLAN，代號:NNtps:持續分鐘:爬升分鐘）。TPS＝聊天 API 每秒請求數（含開場問候）
# A、B 各自打滿 1 倍 118／3 倍 354 TPS（客戶 2026-11-13 確認；不依占比拆分）
V3_PLAN_X1_A='x1:118tps:10:1'
V3_PLAN_X1_B='x1:118tps:10:1'
V3_PLAN_X3_A='x3:354tps:10:1'
V3_PLAN_X3_B='x3:354tps:10:1'
# 試跑（k6menu 2）：低流量，A、B 各 3 分鐘
V3_PLAN_SMOKE='s0:5tps:2:1'
# A 結束到 B 開始的休息分鐘數（讓 A 的影響消退，B 的數據才乾淨）
V3_GAP_MIN=2
# 回應時間門檻（毫秒，以 V3_LATENCY_PCT 百分位判定；只看固定負載期間，不含爬升）
V3_A_MAX_MS=6000
V3_B_MAX_MS=20000
V3_LATENCY_PCT=95
# 失敗率（對話失敗筆數 ÷ 對話總筆數）門檻（客戶 2026-11-13：暫定 0.5%）
V3_FAIL_RATE=0.005
# 自動停止：開始前在 k6menu 選擇，這裡是預設值（直接按 Enter）。false＝一律打完
# 開啟時：開始 V3_ABORT_DELAY 後，累計失敗率 > V3_ABORT_FAIL_RATE 就停止「這支」腳本，休息後照樣跑下一支
V3_ABORT_DEFAULT=false
V3_ABORT_FAIL_RATE=0.05
V3_ABORT_DELAY=3m
# VU：預設最高 TPS × 20／× 30（同對話回應時間測試）；報表出現 dropped_iterations 時調高
# V3_PRE_VUS=
# V3_MAX_VUS=
V3_REPORT_TITLE='新阿發 對話回應時間測試報告'

# ---------- 停止條件（k6 自動中止為第二道防線；第一道是看 GCP 監控） ----------
ABORT=true
ABORT_DELAY=3m
ABORT_ERROR_RATE=0.05
ABORT_P99_FACTOR=2
# 保留 k6 的 exit code：0 正常結束、99 門檻未過或自動中止、105 手動中止
THRESHOLD_FAIL_EXIT_ZERO=false

# ---------- runner 本機輸出 ----------
# 每隔幾秒把 k6 CSV 複製到輸出目錄（control 壓測中 collect 時拿得到最新數據）
UPLOAD_INTERVAL_S=120
# sar 取樣間隔（秒）
SAR_INTERVAL_S=10
# k6 即時畫面：只聽 runner 本機，不對外開 port；從 control 用 k6ctl dashboard 建 SSH tunnel 查看（每台只代表 1/3 負載）
K6_WEB_DASHBOARD_PORT=5665
K6_WEB_DASHBOARD_HOST=127.0.0.1

# ---------- control ----------
# runner 上執行 k6 的帳號（control 以此帳號 SSH 登入）
RUNNER_SSH_USER=k6
REPORT_TITLE='新阿發 壓力測試報告（地端）'
# k6menu 出問題時提示的聯絡窗口
SUPPORT_CONTACT='MF 壓測支援 tsc-pdev.service@microfusion.cloud'

# 地端壓測的預設參數（隨程式版本控管，不要在 VM 上改這個檔）
# 依「新阿發_壓力測試_地端執行環境規劃_v1.0」。環境相關的值（受測端、runner IP）寫在 /etc/k6-stress/stress.env，會覆蓋這裡的值。
# 格式：shell 變數（k6ctl 以 bash source 讀取）；含分號或空白的值要加單引號。參數說明見 runner/k6/README.md。

# ---------- 負載模型（規劃 p.6～7） ----------
# STAGE_PLAN 以聊天 API 的每秒請求數（tps）定義；每段對話＝開場問候＋8～11 則訊息，平均 10.5 次請求
# 階段：S0 Smoke 5 → S1 Baseline 30 → S2 1 倍 118 → S3 3 倍 354 → S4 Recovery 30 TPS，每階爬升 1 分鐘
STAGE_PLAN='s0:5tps:10:1;s1:30tps:15:1;s2:118tps:30:1;s3:354tps:60:1;s4:30tps:15:1'
# 1 倍的每秒新開對話數＝118 TPS ÷ 10.5（只影響 log 與通知中的「倍數」顯示，階段流量以 STAGE_PLAN 的 tps 為準）
BASE_CONV_RATE=11.24
MSGS_MIN=8
MSGS_MAX=11
# 訊息之間停頓 5～15 秒
THINK_TIME_S=10
THINK_JITTER=0.5
# VU 估算：每段對話約 210 秒 → S3 合計約 7,080 VU；回應變慢時最多約 10,500（每台約 3,500）
CONV_P95_S=210
MAX_VUS=10500

# ---------- 業務情境：「業務情境組合」黃色列（與 Cloud Run 版相同） ----------
# B1 開場問候為每段對話開頭；B2、B2-2、B3、B4、B5、C1 依權重抽選；A4 Token 續期需要登入，不在腳本流程內
SCENARIO_WEIGHTS='B2:28;B2-2:36;B3:15;B4:5;B5:2;C1:12'

# ---------- 停止條件（k6 自動中止為第二道防線；第一道是看 GCP 監控） ----------
ABORT=true
ABORT_DELAY=3m
ABORT_ERROR_RATE=0.05
ABORT_P99_FACTOR=2
# 保留 k6 的 exit code：0 正常結束、99 門檻未過或自動中止、105 手動中止
THRESHOLD_FAIL_EXIT_ZERO=false

# ---------- runner 本機輸出 ----------
# 每隔幾秒把 k6 CSV 複製到輸出目錄（control 壓測中 collect 時拿得到最新數據）
UPLOAD_INTERVAL_S=120
# sar 取樣間隔（秒）
SAR_INTERVAL_S=10
# k6 即時畫面：只聽 runner 本機，不對外開 port；從 control 用 k6ctl dashboard 建 SSH tunnel 查看（每台只代表 1/3 負載）
K6_WEB_DASHBOARD_PORT=5665
K6_WEB_DASHBOARD_HOST=127.0.0.1

# ---------- control ----------
# runner 上執行 k6 的帳號（control 以此帳號 SSH 登入）
RUNNER_SSH_USER=k6
REPORT_TITLE='新阿發 壓力測試報告（地端）'

# 環境設定：install.sh --role control 會複製成 /etc/k6-stress/stress.env（已存在時不覆蓋）
# 這裡的值會覆蓋 /opt/k6-stress/onprem/config/defaults.env；未列出的參數沿用預設值。

# ---------- 受測端（MF 提供 UAT 網域） ----------
# 聊天 API 的根網址（腳本打 ${BASE_URL}/api/chat/ask）
BASE_URL=https://<UAT 網域>
# 連線預檢步驟 4 的前端頁面
FRONTEND_URL=https://<UAT 網域>/
# 打本機以外的位址必須設為 true（k6 腳本的防呆）
ALLOW_REMOTE_TARGET=true

# ---------- runner（DMZ 內部 IP 或主機名稱，分號分隔；順序決定 task 編號） ----------
RUNNERS='<k6-runner-01 IP>;<k6-runner-02 IP>;<k6-runner-03 IP>'

# ---------- 其他（選填） ----------
# 門檻（毫秒／比例），k6 與報表共用；未設定時用證券方文件參考值
# THRESHOLDS_JSON='{"faq":{"p95":10000,"p99":20000},"business":{"p95":5000,"p99":10000},"error_rate":0.005}'
# 預檢時預期的 TLS 憑證簽發者（正規表示式）；不符時代表可能被 SSL inspection 攔截
# EXPECTED_TLS_ISSUER='Google Trust Services'
